[Unit]
Description=Faujii Tour & Travels (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/faujii
EnvironmentFile=/etc/faujii.env
ExecStart=/var/www/faujii/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
